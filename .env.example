DATABASE_PATH=data/agentwin.db
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Local Qwen through LM Studio (recommended starting provider)
LLM_PROVIDER=lmstudio
LLM_MODEL=qwen/qwen3-4b-2507
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio

# Optional email delivery for live-session alerts and scheduled summaries.
# Project Settings can override the default recipient; SMTP credentials stay server-side.
AGENTWIN_EMAIL_TO=
AGENTWIN_EMAIL_FROM=
AGENTWIN_SMTP_HOST=
AGENTWIN_SMTP_PORT=587
AGENTWIN_SMTP_SECURITY=starttls
AGENTWIN_SMTP_USER=
AGENTWIN_SMTP_PASSWORD=

# Optional cloud provider instead:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5.6-luna
# OPENAI_API_KEY=
